# ---- app ----
NODE_ENV=development
PORT=8130
# Address browsers use to reach this API (used in signed local-storage URLs)
PUBLIC_BASE_URL=http://localhost:8130
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5180
# Proxies in front of the API (nginx / load balancer). 0 locally, usually 1 on a server.
TRUST_PROXY_HOPS=0
# Swagger UI at /api-docs (default: on, except NODE_ENV=production)
API_DOCS=true

# ---- access (no login yet) ----
# Shared team key sent by the presenter app in the X-Team-Key header
TEAM_KEY=
# Secret used to sign short-lived host tokens for the live console
HOST_TOKEN_SECRET=

# ---- database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=public

# ---- storage ----
# local = files on this machine (development), s3 = AWS S3 (+ CloudFront later)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Folder prefix inside the bucket, so an existing shared bucket can be reused safely
STORAGE_PREFIX=sales-demo
AWS_REGION=ap-south-1
S3_BUCKET=

# ---- uploads & playback ----
MAX_UPLOAD_BYTES=2147483648
UPLOAD_PART_BYTES=16777216
PLAYBACK_URL_TTL_SEC=14400

# ---- worker (video processing) ----
# Videos processed at the same time by one worker process
WORKER_CONCURRENCY=1
# Leave empty to use the ffmpeg bundled with npm (development); set to the system binary in Docker
FFMPEG_PATH=
FFPROBE_PATH=

# ---- live sync relay (presenter console <-> client viewers) ----
# Seconds a live session stays open after the console disconnects (it may be reconnecting)
SYNC_HOST_GRACE_SEC=300
SYNC_MAX_VIEWERS=50
HOST_TOKEN_TTL_SEC=43200

# ---- housekeeping ----
TRASH_RETENTION_DAYS=30
# Unfinished uploads older than this are cancelled by the nightly cleanup
UPLOAD_ABANDON_HOURS=24
# Videos stuck in "processing" longer than this are queued again
PROCESSING_REQUEUE_MINUTES=60
