{
  "name": "nupi-salesdemo-be",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the NupiPay Sales Demo Room (shared library, uploads, demos, live sync relay)",
  "main": "build/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/index.ts",
    "dev:worker": "cross-env NODE_ENV=development nodemon src/worker.ts",
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "start": "node build/index.js",
    "start:worker": "node build/worker.js",
    "typecheck": "tsc --noEmit",
    "cleanup:now": "ts-node src/scripts/cleanupNow.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/configs/database.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/configs/database.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/configs/database.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migration:show:prod": "typeorm migration:show -d build/configs/database.js",
    "migration:run:prod": "typeorm migration:run -d build/configs/database.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/cloudfront-signer": "^3.1166.0",
    "@aws-sdk/lib-storage": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.31",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.18",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.7",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.1",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
